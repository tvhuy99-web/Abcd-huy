msgstr "Vị trí so với nhân vật: %s"

msgid "Selecting a map tile only moves the cursor; travel is a separate command."
msgstr "Chọn ô bản đồ chỉ di chuyển con trỏ; muốn đi phải dùng lệnh du lịch riêng."

