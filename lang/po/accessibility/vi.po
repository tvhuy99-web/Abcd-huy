"Move the cursor to inspect tiles. Confirm to finish here, or cancel to return."
msgstr ""
"Di chuyển con trỏ để xem xét các ô. Xác nhận để hoàn tất tại đây, hoặc hủy để quay lại."

msgid "Move zone"
msgstr "Di chuyển vùng"

msgid "Movement and looking"
msgstr "Di chuyển và quan sát"

msgid "Movement mode"
msgstr "Chế độ di chuyển"

