msgstr "Bảng %d trên %d trong thứ tự hiển thị. Rộng: %d. Cao: %d."

msgid "Passive"
msgstr "Bị động"

msgid "Perception"
msgstr "Tri giác"

msgid "Personal zone: it moves with you."
msgstr "Vùng cá nhân: nó di chuyển theo bạn."

msgid "Placement"
msgstr "Vị trí đặt"

#, c-format
