msgstr[0] "%lu bản lưu"

msgid "Not set"
msgstr "Chưa đặt"

#, c-format
msgid "Character: %1$s. Scenario: %2$s. Profession: %3$s."
msgstr "Nhân vật: %1$s. Kịch bản: %2$s. Nghề nghiệp: %3$s."

