msgstr "Chưa có đồng đội nào trong nhiệm vụ này sẵn sàng trở về."

msgid "No companions."
msgstr "Không có đồng đội."

msgid "No conflict with any other action."
msgstr "Không xung đột với hành động nào khác."

msgid "No entries match the current category or filter."
msgstr "Không có mục nào khớp danh mục hoặc bộ lọc hiện tại."

msgid "No fruit yet"
msgstr "Chưa có trái cây"

msgid "No fruit yet."
msgstr "Chưa có trái cây."

