msgstr "Bán kính vùng nguy hiểm: %d ô"

#, c-format
msgid "Adjacent map tile: %s"
msgstr "Ô bản đồ kế cận: %s"

msgid "Current route"
msgstr "Tuyến hiện tại"

msgid "No route is set."
msgstr "Chưa đặt tuyến đường."

#, c-format
msgid "Planned destination: %1$s. Overmap coordinates: X %2$d, Y %3$d, level %4$d."
msgstr "Điểm đến đã đặt: %1$s. Tọa độ bản đồ lớn: X %2$d, Y %3$d, tầng %4$d."

#, c-format
msgid "Route map tiles: %1$d. Relative location: %2$s."
msgstr "Số ô bản đồ trên tuyến: %1$d. Vị trí tương đối: %2$s."

#, c-format
msgid "Sleepiness: %s"
msgstr "Buồn ngủ: %s"

#, c-format
msgid "Stamina: %d%%"
msgstr "Thể lực: %d%%"

#, c-format
msgid "%s: health indicator %d of 5"
msgstr "%s: chỉ báo sức khỏe %d trên 5 vạch"

msgid "Vehicle controls"
msgstr "Điều khiển phương tiện"

msgid "World"
msgstr "Thế giới"

msgid "Character status"
msgstr "Trạng thái nhân vật"

msgid "Scan radius, from 1 to 16"
msgstr "Bán kính quét, từ 1 đến 16 ô"

msgid "Vertical memory scan depth, from 0 to 10"
msgstr "Độ sâu quét trí nhớ theo tầng, từ 0 đến 10"

msgid "All nearby tiles"
msgstr "Tất cả ô lân cận"

msgid "Known tiles only"
msgstr "Chỉ ô đã biết"

msgid "Noteworthy tiles only"
msgstr "Chỉ ô đáng chú ý"

msgid "Heard sound markers only"
msgstr "Chỉ dấu âm thanh đã nghe"

msgid "Show all nearby tiles and label unexplored tiles as unknown."
msgstr "Hiện mọi ô lân cận; ô chưa khám phá được ghi là chưa biết."

msgid "Show visible or remembered tiles and tiles with a sound marker."
msgstr "Hiện ô đang thấy, ô đã nhớ và ô có dấu âm thanh."

msgid "Show visible fields, traps, creatures, special perceptions, items, vehicles, obstacles, known doors and stairs, remembered furniture, and heard markers."
msgstr "Hiện ô có trường, bẫy, sinh vật, cảm nhận đặc biệt, vật phẩm, phương tiện, chướng ngại vật, cửa và cầu thang đã biết, đồ đạc đã nhớ và dấu âm thanh đã nghe."

msgid "Special perception: %s"
msgstr "Cảm nhận đặc biệt: %s"

msgid "You sense something here."
msgstr "Bạn cảm nhận được điều gì đó ở đây."

msgid "Show only the game's heard sound markers. A marker is approximate and does not reveal a creature's true position."
msgstr "Chỉ hiện dấu âm thanh mà game đã cho nghe. Dấu chỉ vị trí ước lượng, không tiết lộ vị trí thật của sinh vật."

#, c-format
msgid "Near this marker, you heard %s. The marker is approximate and may not be the sound source's position."
msgstr "Gần dấu này, bạn đã nghe thấy %s. Dấu chỉ vị trí ước lượng và có thể không phải nơi phát ra âm thanh."

#, c-format
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

msgid "Known trap"
msgstr "Bẫy đã biết"

msgid "Visible creature"
msgstr "Sinh vật đang nhìn thấy"

msgid "Special perception"
msgstr "Cảm nhận đặc biệt"

msgid "Visible field"
msgstr "Trường đang nhìn thấy"

msgid "Visible obstacle"
msgstr "Chướng ngại vật đang nhìn thấy"

msgid "Known route feature"
msgstr "Lối đi đã biết"

msgid "Approximate sound marker"
msgstr "Dấu âm thanh ước lượng"

msgid "Visible vehicle"
msgstr "Phương tiện đang nhìn thấy"

msgid "Visible items"
msgstr "Vật phẩm đang nhìn thấy"

msgid "Known furniture"
msgstr "Đồ đạc đã biết"

msgid "Noteworthy information"
msgstr "Thông tin đáng chú ý"

msgid "This scan reads only remembered terrain and furniture on other levels. Reading the map does not advance game time."
msgstr "Lần quét này chỉ đọc địa hình và đồ đạc đã nhớ ở tầng khác. Đọc bản đồ không làm thời gian trong game trôi qua."

msgid "Current activity"
msgstr "Hoạt động hiện tại"

msgid "Sleeping. The game will continue until you wake up."
msgstr "Đang ngủ. Game sẽ tiếp tục cho đến khi bạn tỉnh dậy."

msgid "Ongoing activity."
msgstr "Hoạt động đang diễn ra."

msgid "Pause can request interruption; the game will ask before canceling."
msgstr "Lệnh Tạm dừng có thể yêu cầu ngắt hoạt động; game sẽ hỏi trước khi hủy."

msgid "Pause cannot interrupt this activity right now."
msgstr "Hiện không thể dùng lệnh Tạm dừng để ngắt hoạt động này."

msgid "Activity in progress"
msgstr "Hoạt động đang diễn ra"

msgid "Automatic travel"
msgstr "Tự động di chuyển"

msgid "Travel is in progress."
msgstr "Đang di chuyển theo tuyến đã đặt."

msgid "Interruptibility"
msgstr "Khả năng ngắt"

msgid "Can request interruption with Pause"
msgstr "Có thể yêu cầu ngắt bằng lệnh Tạm dừng"

msgid "Cannot interrupt with Pause right now"
msgstr "Hiện không thể ngắt bằng lệnh Tạm dừng"

msgid "Can request cancellation with Pause"
msgstr "Có thể yêu cầu hủy bằng lệnh Tạm dừng"

msgid "The game will ask before canceling."
msgstr "Game sẽ hỏi trước khi hủy."

msgid "Recent messages"
msgstr "Thông báo gần đây"

msgid "Remembered"
msgstr "Chỉ còn trong trí nhớ"

msgid "Unknown"
msgstr "Chưa biết"

msgid "Character creation"
msgstr "Tạo nhân vật"

msgid "Character rating"
msgstr "Đánh giá nhân vật"

#, c-format
msgid "Selected: %1$s. Available: %2$s."
msgstr "Đã chọn: %1$s. Hiện có: %2$s."

msgid "Each requirement group must be met. Within this group, choose one alternative:"
msgstr "Cần đáp ứng từng nhóm yêu cầu. Trong nhóm này, chọn một phương án:"

msgid "Available."
msgstr "Đã có đủ."

msgid "Missing."
msgstr "Còn thiếu."

#, c-format
msgid "%1$s. Group %2$d"
msgstr "%1$s. Nhóm %2$d"

msgid "Qualities"
msgstr "Chức năng dụng cụ"

msgid "Tools"
msgstr "Dụng cụ"

msgid "Components"
msgstr "Nguyên liệu"

#, c-format
msgid "Batch size: %d"
msgstr "Số lượng mỗi mẻ: %d"

msgid "Batch size"
msgstr "Số lượng mỗi mẻ"

msgid "Choose 1 to 50. Applying a quantity does not start crafting."
msgstr "Chọn từ 1 đến 50. Áp dụng số lượng chưa bắt đầu chế tạo."

msgid "Can craft"
msgstr "Có thể chế tạo"

msgid "Cannot craft"
msgstr "Chưa thể chế tạo"

msgid "Recipe details"
msgstr "Chi tiết công thức"

msgid "Character requirements:"
