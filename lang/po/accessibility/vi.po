msgstr "Hiện mọi ô lân cận; ô chưa khám phá được ghi là chưa biết."

msgid "Show visible or remembered tiles and tiles with a sound marker."
msgstr "Hiện ô đang thấy, ô đã nhớ và ô có dấu âm thanh."

msgid "Show visible fields, traps, creatures, special perceptions, items, vehicles, obstacles, known doors and stairs, remembered furniture, and heard markers."
msgstr "Hiện ô có trường, bẫy, sinh vật, cảm nhận đặc biệt, vật phẩm, phương tiện, chướng ngại vật, cửa và cầu thang đã biết, đồ đạc đã nhớ và dấu âm thanh đã nghe."

msgid "Special perception: %s"
msgstr "Cảm nhận đặc biệt: %s"

msgid "You sense something here."
msgstr "Bạn cảm nhận được điều gì đó ở đây."

msgid "Show only the game's heard sound markers. A marker is approximate and does not reveal a creature's true position."
msgstr "Chỉ hiện dấu âm thanh mà game đã cho nghe. Dấu chỉ vị trí ước lượng, không tiết lộ vị trí thật của sinh vật."

#, c-format
msgid "Near this marker, you heard %s. The marker is approximate and may not be the sound source's position."
msgstr "Gần dấu này, bạn đã nghe thấy %s. Dấu chỉ vị trí ước lượng và có thể không phải nơi phát ra âm thanh."

#, c-format
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

