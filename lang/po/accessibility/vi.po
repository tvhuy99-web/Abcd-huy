msgstr " %1$s: %2$d%%."

msgid "Vehicle: %1$s. Status: %2$s. Mass: %3$.0f %4$s. Cargo: %5$s of %6$s %7$s."
msgstr "Xe: %1$s. Trạng thái: %2$s. Khối lượng: %3$.0f %4$s. Hàng hóa: %5$s trên %6$s %7$s."

msgid "Hard limit: at or below this battery charge, the controller forbids discharging the battery for the electric motors."
msgstr "Giới hạn cứng: khi mức pin bằng hoặc dưới ngưỡng này, bộ điều khiển cấm xả pin cho động cơ điện."

msgid "Soft limit: at or below this battery charge, the controller charges the battery toward this level and limits discharging; above it, discharging is allowed."
msgstr "Giới hạn mềm: khi mức pin bằng hoặc dưới ngưỡng này, bộ điều khiển sạc pin hướng tới mức này và hạn chế xả pin; trên mức này, xả pin được phép."

msgid "The save for \"%1$s\" in world \"%2$s\" could not be loaded because the world could not be prepared. The save was not changed, overwritten, or deleted. You can try another save or world from the main menu."
msgstr "Không tải được bản lưu của \"%1$s\" trong thế giới \"%2$s\" vì không chuẩn bị được thế giới. Bản lưu không bị thay đổi, ghi đè hay xóa. Bạn có thể thử bản lưu hoặc thế giới khác từ menu chính."

msgid "The save for \"%1$s\" in world \"%2$s\" could not be loaded. It may be damaged, missing, or from an incompatible version. The save was not changed, overwritten, or deleted. You can choose another save or return to the main menu."
msgstr "Không tải được bản lưu của \"%1$s\" trong thế giới \"%2$s\". Bản lưu có thể đã hỏng, bị thiếu, hoặc thuộc phiên bản không tương thích. Bản lưu không bị thay đổi, ghi đè hay xóa. Bạn có thể chọn bản lưu khác hoặc quay lại menu chính."

