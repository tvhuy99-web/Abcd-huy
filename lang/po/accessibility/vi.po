msgstr "Không thể lắp bộ phận này tại đây. Phần yêu cầu cho biết lý do."

msgid "Broken; repairing replaces it."
msgstr "Đã hỏng; sửa chữa sẽ thay mới."

msgid "There are no parts which can be repaired here."
msgstr "Không có bộ phận nào sửa được tại đây."

msgid "This part cannot be removed."
msgstr "Không thể tháo bộ phận này."

msgid "Browsing does not change the vehicle; activate a part to choose it."
msgstr "Duyệt qua không làm thay đổi xe; kích hoạt một bộ phận để chọn nó."

msgid "Battery low threshold"
msgstr "Ngưỡng pin thấp"

msgid "Battery high threshold"
msgstr "Ngưỡng pin cao"

msgid "Smart Engine Controller"
msgstr "Bộ điều khiển động cơ thông minh"

msgid "Smart engine controller: %1$s. Battery low threshold: %2$d%%. Battery high threshold: %3$d%%."
msgstr "Bộ điều khiển động cơ thông minh: %1$s. Ngưỡng pin thấp: %2$d%%. Ngưỡng pin cao: %3$d%%."

msgid "Open the smart engine controller user manual."
msgstr "Mở hướng dẫn sử dụng bộ điều khiển động cơ thông minh."

msgid "Safe speed: %1$s. Top speed: %2$s %3$s."
msgstr "Tốc độ an toàn: %1$s. Tốc độ tối đa: %2$s %3$s."

