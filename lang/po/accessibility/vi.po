msgstr "Không có kỹ năng thành thạo."

msgid ""
"No route was set: auto travel requires source and destination on the same Z level."
msgstr ""
"Chưa đặt được tuyến: di chuyển tự động đòi hỏi điểm đi và điểm đến ở cùng một mức Z."

msgid "No route was set: the destination tile is unexplored."
msgstr "Chưa đặt được tuyến: ô đích chưa được khám phá."

msgid "No route was set: unable to find a path to the destination."
msgstr "Chưa đặt được tuyến: không tìm được đường tới điểm đến."

msgid "No trade took place. Nothing was exchanged."
msgstr "Không có giao dịch nào diễn ra. Không có gì được trao đổi."

msgid "No zone is selected."
msgstr "Chưa chọn vùng nào."

