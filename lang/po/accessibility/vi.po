msgstr "Tất cả ô lân cận"

msgid "Known tiles only"
msgstr "Chỉ ô đã biết"

msgid "Noteworthy tiles only"
msgstr "Chỉ ô đáng chú ý"

msgid "Heard sound markers only"
msgstr "Chỉ dấu âm thanh đã nghe"

