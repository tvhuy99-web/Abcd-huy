msgstr "Chỉ dời điểm ngắm đi một ô. Việc này không bắn và không tốn lượt."

msgid "Moves only the aim point down one level. This does not fire or spend a turn."
msgstr "Chỉ dời điểm ngắm xuống một tầng. Việc này không bắn và không tốn lượt."

msgid "Moves only the aim point up one level. This does not fire or spend a turn."
msgstr "Chỉ dời điểm ngắm lên một tầng. Việc này không bắn và không tốn lượt."

#, c-format
msgid "Mutations: %1$s. %2$d active, %3$d passive."
msgstr "Đột biến: %1$s. %2$d chủ động, %3$d bị động."

msgid "Needs and condition"
msgstr "Nhu cầu và tình trạng"

#, c-format
