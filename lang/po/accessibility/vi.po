msgid "Commands for the current screen"
msgstr "Các lệnh của màn hình hiện tại"

msgid "These are registered commands. Screen contents may require a dedicated reader."
msgstr "Đây là các lệnh đã đăng ký. Nội dung màn hình có thể cần bộ đọc riêng."

msgid "This entry cannot be selected."
msgstr "Không thể chọn mục này."

msgid "Cataclysm: Dark Days Ahead - Main menu"
msgstr "Cataclysm: Dark Days Ahead. Menu chính"

msgid "Read this text"
msgstr "Đọc văn bản này"

msgid "Dialog"
msgstr "Hộp thoại"

msgid "Number"
msgstr "Số"

msgid "Text"
msgstr "Văn bản"

msgid "Unknown tile."
msgstr "Chưa biết ô này."

msgid "Remembered, not currently visible: "
msgstr "Chỉ còn trong trí nhớ, hiện không nhìn thấy: "

msgid "Current tile"
msgstr "Ô hiện tại"

msgid "One level above"
msgstr "Tầng phía trên"

msgid "One level below"
msgstr "Tầng phía dưới"

#, c-format
msgid "Bleeding is worsening at %s."
msgstr "Chảy máu ở %s đang nặng hơn."

#, c-format
msgid "Bleeding stopped at %s."
msgstr "Đã cầm máu ở %s."

#, c-format
msgid "%s is broken."
msgstr "%s bị gãy."

#, c-format
msgid "%s is no longer broken."
msgstr "%s đã hết gãy."

#, c-format
msgid "A bite was detected on %s."
msgstr "Phát hiện vết cắn ở %s."

#, c-format
msgid "An infection was detected in %s."
msgstr "Phát hiện nhiễm trùng ở %s."

#, c-format
msgid "The infection cleared in %s."
msgstr "Nhiễm trùng ở %s đã hết."

msgid "No current warning"
msgstr "Không có cảnh báo hiện tại"

msgid "Critically low"
msgstr "Rất thấp"

msgid "Low"
msgstr "Thấp"

#, c-format
msgid "%1$s is worsening: %2$s"
msgstr "%1$s đang xấu đi: %2$s"

#, c-format
msgid "%1$s is improving: %2$s"
msgstr "%1$s đang cải thiện: %2$s"

#, c-format
msgid "North %d"
msgstr "Bắc %d ô"

#, c-format
msgid "South %d"
msgstr "Nam %d ô"

#, c-format
msgid "West %d"
msgstr "Tây %d ô"

#, c-format
msgid "East %d"
msgstr "Đông %d ô"

#, c-format
msgid "Sleepiness: %s"
msgstr "Buồn ngủ: %s"

#, c-format
msgid "Stamina: %d%%"
msgstr "Thể lực: %d%%"

#, c-format
msgid "%s: health indicator %d of 5"
msgstr "%s: chỉ báo sức khỏe %d trên 5 vạch"

msgid "Vehicle controls"
msgstr "Điều khiển phương tiện"

msgid "World"
msgstr "Thế giới"

msgid "Character status"
msgstr "Trạng thái nhân vật"

msgid "Scan radius, from 1 to 16"
msgstr "Bán kính quét, từ 1 đến 16 ô"

msgid "Recent messages"
msgstr "Thông báo gần đây"

msgid "Remembered"
msgstr "Chỉ còn trong trí nhớ"

msgid "Unknown"
msgstr "Chưa biết"

msgid "Character creation"
msgstr "Tạo nhân vật"

msgid "Character rating"
msgstr "Đánh giá nhân vật"

#, c-format
msgid "Selected: %1$s. Available: %2$s."
msgstr "Đã chọn: %1$s. Hiện có: %2$s."

msgid "Each requirement group must be met. Within this group, choose one alternative:"
msgstr "Cần đáp ứng từng nhóm yêu cầu. Trong nhóm này, chọn một phương án:"

msgid "Available."
msgstr "Đã có đủ."

msgid "Missing."
msgstr "Còn thiếu."

#, c-format
msgid "%1$s. Group %2$d"
msgstr "%1$s. Nhóm %2$d"

msgid "Qualities"
msgstr "Chức năng dụng cụ"

msgid "Tools"
msgstr "Dụng cụ"

msgid "Components"
msgstr "Nguyên liệu"

#, c-format
msgid "Batch size: %d"
msgstr "Số lượng mỗi mẻ: %d"

msgid "Batch size"
msgstr "Số lượng mỗi mẻ"

msgid "Choose 1 to 50. Applying a quantity does not start crafting."
msgstr "Chọn từ 1 đến 50. Áp dụng số lượng chưa bắt đầu chế tạo."

msgid "Can craft"
msgstr "Có thể chế tạo"

msgid "Cannot craft"
msgstr "Chưa thể chế tạo"

msgid "Recipe details"
msgstr "Chi tiết công thức"

msgid "Character requirements:"
msgstr "Yêu cầu về nhân vật:"

msgid "Character resources:"
msgstr "Tài nguyên của nhân vật:"

#, c-format
msgid "%1$s: need %2$d; available %3$d."
msgstr "%1$s: cần %2$d; hiện có %3$d."

msgid "Construction details"
msgstr "Chi tiết xây dựng"

msgid "Requirements or location are missing."
msgstr "Chưa đủ điều kiện hoặc chưa có vị trí phù hợp."

msgid "Skills and materials are sufficient."
msgstr "Đã đủ kỹ năng và vật liệu."

msgid "Skills or materials are missing."
msgstr "Còn thiếu kỹ năng hoặc vật liệu."

msgid "A nearby location meets the construction conditions."
msgstr "Có vị trí lân cận đáp ứng điều kiện xây dựng."

msgid "No nearby location meets the construction conditions."
msgstr "Chưa có vị trí lân cận đáp ứng điều kiện xây dựng."

msgid "Read a direction, then activate it to choose. Reading does not act."
msgstr "Đọc một hướng, sau đó kích hoạt để chọn hướng đó. Chỉ đọc chưa thực hiện hành động."

msgid "This location is valid for the selected construction."
msgstr "Vị trí này phù hợp với công trình đã chọn."

msgid "This location is not valid for the selected construction."
msgstr "Vị trí này không phù hợp với công trình đã chọn."

msgid "Buildable here"
msgstr "Xây được tại đây"

msgid "Ready (missing location)"
msgstr "Đủ yêu cầu, còn thiếu vị trí"

msgid "Item info"
msgstr "Thông tin vật phẩm"

#, c-format
msgid "Filter: %s"
msgstr "Bộ lọc: %s"

msgid "Crafting"
msgstr "Chế tạo"

msgid "Construction"
msgstr "Xây dựng"

msgid "Blueprint"
msgstr "Bản thiết kế"

msgid "Batch"
msgstr "Theo mẻ"

msgid "Favorite"
msgstr "Yêu thích"

msgid "Description"
msgstr "Mô tả"

msgid "Splinted. Mending progress is unknown."
msgstr "Đang bó nẹp. Chưa biết tiến độ liền xương."

#, c-format
msgid "Splinted. Mending indicator %d of 5."
msgstr "Đang bó nẹp. Chỉ báo liền xương: %d trên 5 mức."

msgid "Broken."
msgstr "Bị gãy."

#, c-format
msgid "Health indicator: %d full segments of 5."
msgstr "Chỉ báo sức khỏe: %d vạch đầy trên 5 vạch."

msgid "One additional half segment."
msgstr "Có thêm nửa vạch."

msgid "Less than half a segment remains."
msgstr "Còn ít hơn nửa vạch."

#, c-format
msgid "Missing required proficiency: %s"
msgstr "Thiếu kiến thức thực hành bắt buộc: %s"

#, c-format
msgid "Missing optional proficiency: %s"
msgstr "Thiếu kiến thức thực hành bổ trợ: %s"

msgid "Treatment requirements are met."
msgstr "Đã đủ điều kiện điều trị."

msgid "Treatment requirements are not met."
msgstr "Chưa đủ điều kiện điều trị."

msgid "No body part is selected."
msgstr "Chưa chọn bộ phận cơ thể."

msgid "Medical"
msgstr "Y tế"

msgid "Limbs"
msgstr "Các bộ phận cơ thể"

msgid "Summary"
msgstr "Tổng quan"

msgid "Select the focused visible target"
msgstr "Chọn mục tiêu đang được đọc"

msgid "At your position"
msgstr "Ngay vị trí của bạn"

#, c-format
msgid "Above %d"
msgstr "Phía trên %d tầng"

#, c-format
msgid "Below %d"
msgstr "Phía dưới %d tầng"

msgid "Targeting"
msgstr "Đang ngắm"

msgid "Target selection"
msgstr "Chọn mục tiêu"

#, c-format
msgid "Range: %1$d. Targets in range: %2$d. "
msgstr "Tầm ngắm: %1$d ô. Mục tiêu trong tầm: %2$d. "

msgid "Ready to aim or confirm."
msgstr "Có thể ngắm hoặc xác nhận."

msgid "No valid target is selected."
msgstr "Chưa chọn được mục tiêu hợp lệ."

msgid "No ammunition or this weapon cannot fire."
msgstr "Hết đạn hoặc vũ khí không thể bắn."

msgid "The current aim point is out of range."
msgstr "Điểm ngắm hiện tại nằm ngoài tầm."

msgid "Current aim point"
msgstr "Điểm ngắm hiện tại"

#, c-format
msgid "%1$s, distance %2$d"
msgstr "%1$s, cách %2$d ô"

#, c-format
msgid "Visible creature: %s"
msgstr "Sinh vật đang nhìn thấy: %s"

#, c-format
msgid "Visible vehicle: %s"
msgstr "Phương tiện đang nhìn thấy: %s"

msgid "No visible creature or vehicle is under the aim point."
msgstr "Không có sinh vật hoặc phương tiện đang nhìn thấy tại điểm ngắm."

msgid "Creature"
msgstr "Sinh vật"

msgid "Vehicle"
msgstr "Phương tiện"

msgid "Cannot change target while the weapon has no ammunition."
msgstr "Không thể đổi mục tiêu khi vũ khí đã hết đạn."

#, c-format
msgid "Targetable entity %d"
msgstr "Đối tượng có thể ngắm số %d"

msgid "Target list note"
msgstr "Ghi chú danh sách mục tiêu"

msgid ""
"The list shows the first 256 targets. Use the next and previous "
"target commands to move through the full target list."
msgstr ""
"Danh sách đọc trực tiếp 256 mục tiêu đầu tiên. Dùng lệnh "
"mục tiêu tiếp theo và trước đó để duyệt toàn bộ danh sách."

msgid "How target selection works"
msgstr "Cách chọn mục tiêu"

msgid ""
"Activate a listed target to move the aim point. This does not fire or spend "
"a turn. Use the fire command separately to confirm an attack."
msgstr ""
"Kích hoạt mục tiêu trong danh sách để chuyển điểm ngắm. Thao tác này không "
"bắn và không tiêu lượt. Dùng riêng lệnh bắn để xác nhận tấn công."
